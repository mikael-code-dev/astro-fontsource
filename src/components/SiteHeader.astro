---
import { Image } from "astro:assets";
import { navigationLinks } from "../data/navigation";
import logoImage from "../assets/images/logo.svg";

const pathname = Astro.url.pathname;

const isCurrentRoute = (href: string) => {
  const route = href.split("#")[0];
  if (route === "/") {
    return pathname === "/";
  }
  return pathname === route || pathname.startsWith(`${route}/`);
};

interface Props {
  companyName?: string;
  showCta?: boolean;
  ctaText?: string;
  ctaPath?: string;
  phoneText?: string;
  phoneNumber?: string;
}

const {
  companyName = "My Company",
  showCta = true,
  ctaText = "Chat With Us",
  ctaPath = "/contact",
  phoneText = "Call:",
  phoneNumber = "+4612345678",
} = Astro.props;
---

<header class="site-header">
  <div class="upper-header-container">
    <p class="shell tagline-desktop">Tagline for desktop can be much &nbsp;&nbsp;—&nbsp;&nbsp; Longer than it can for Mobile view</p>
    <p class="shell tagline-mobile">As I said, now we want it shorter</p>
  </div>

  <div class="header-container shell">

    <!-- Brand / Logo -->
    <a href="/" class="brand-link" aria-label={`${companyName} - Home`}>
      {logoImage ? (
        <Image 
          src={logoImage} 
          alt={`${companyName} logo`} 
          class="site-logo" 
          width={160} 
          height={40} 
        />
      ) : (
        <span class="brand-text">{companyName}</span>
      )}
    </a>

    <!-- Desktop Navigation -->
    <nav class="main-nav" aria-label="Main Navigation">
      <ul>
        {navigationLinks.map((item) => (
          <li>
            <a 
              href={item.path} 
              class:list={[{ active: isCurrentRoute(item.path) }]}
            >
              {item.title}
            </a></li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (e.g. Mini-CTA) -->
    {showCta && (
      <div class="header-actions">
        <a href={ctaPath} class="header-cta cta-desktop">{ctaText}</a>
        <a href={`tel:${phoneNumber}`} class="header-cta cta-mobile"><em>{phoneText} {phoneNumber}</em></a>
      </div>
    )}

    <!-- Mobile Menu Toggle Button -->
    <button class="mobile-toggle" aria-label="Toggle Navigation" aria-expanded="false">
      <span class="hamburger-icon">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

  </div>
</header>

<style>
  .site-header {
    background-color: color-mix(in srgb, var(--color-bg-alt-one) 90%, transparent 10%);
    border-bottom: 1px solid rgba(0 0 0 / 0.05);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .upper-header-container {
    background-color: var(--color-item-one-dark);
    padding: 0.6rem 0;
    text-transform: uppercase;
  }

  .upper-header-container p {
    color: rgba(255, 254, 240, 0.8);
    font-family: var(--font-second);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 1px;
    text-align: center;
    /* width: 100%; */
  }

  .tagline-mobile {
    display: none;
  }

  .header-container {
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-logo {
    height: auto;
    max-width: 70px;
    object-fit: contain;
  }

  .brand-text {
    font-weight: bold;
    font-size: 1.25rem;
    color: var(--site-text);
  }

  .main-nav ul {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 2.6rem;
  }

  .main-nav a {
    position: relative;
    font-family: var(--font-second);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .main-nav a:hover,
  .main-nav a.active {
    color: var(--color-text-light);
  }

  .main-nav a::before {
    content: "";
    position: absolute;
    top: 25px;
    left: 0;
    right: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text-light);
    opacity: 0;
    transition: transform 300ms ease, opacity 300ms linear;
  }

  .main-nav a:hover::before {
    opacity: 1;
    transform: translateY(-3px);
  }

  .header-cta {
    display: inline-block;
    background-color: transparent;
    font-family: var(--font-second);
    color: var(--color-text-light);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 2px solid var(--color-item-one-dark);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 600;
  }

  .cta-mobile {
    display: none;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: 2px solid var(--color-item-one-dark);
    border-radius: 8px;
    cursor: pointer;
    height: 44px;
    width: 42px;
  }

  .hamburger-icon span {
    display: block;
    width: 25px;
    height: 2px;
    background-color: var(--color-item-one-dark);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .mobile-toggle.is-open .hamburger-icon span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle.is-open .hamburger-icon span:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.is-open .hamburger-icon span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Responsive layout adjustment for mobile */
  @media (max-width: 768px) {
    .tagline-desktop,
    .cta-desktop {
      display: none;
    }

    .tagline-mobile {
      display: block;
    }

    .header-actions {
      display: block;
      margin-left: auto;
      margin-right: 0.5rem;
    }

    .main-nav a::before {
      content: none;
    }

    .cta-mobile {
      display: inline-block;
    }

    .mobile-toggle {
      display: block;
    }

    .site-header {
      /* position: relative; */
    }

    .header-container {
      position: static;
    }

    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: var(--color-bg-alt-one, #fff);
      border-bottom: 1px solid rgb(0 0 0 / 0.1);
      max-height: 0;
      overflow: hidden;
      /* transition: max-height 0.25s ease-in-out, padding 0.25s ease-in-out, width 0.25s; */
      transition: max-height 0.25s ease-out, padding 0.25s ease-in-out, width 0.25s;
      padding: 0 1.5rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
    }

    .main-nav.is-open {
      max-height: 400px; /* Make sure all your links are visible when setting this */
      padding: 1.5rem;
      border-bottom: 1px solid rgb(0 0 0 / 0.2);
    }

    .main-nav ul {
      flex-direction: column;
      align-items: center;
      gap: 1.4rem;
    }
  }
</style>

<script>
  const toggleButton = document.querySelector('.mobile-toggle');
  const mainNav = document.querySelector('.main-nav');

  toggleButton?.addEventListener('click', () => {
    const isOpen = toggleButton.classList.toggle('is-open');
    mainNav?.classList.toggle('is-open', isOpen)
    toggleButton.setAttribute('aria-expanded', String(isOpen));

});
</script>