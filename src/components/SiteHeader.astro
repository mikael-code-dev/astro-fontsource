---
import { Image } from "astro:assets";
import { navigationLinks } from "../data/navigation";
import logoImage from "../assets/images/logo.svg";
import type { string } from "astro:schema";

interface Props {
  companyName?: string;
  showCta?: boolean;
  ctaText?: string;
  ctaPath?: string;
  phoneText?: string;
  phoneNumber?: string;
}

const {
  companyName = "My Company",
  showCta = true,
  ctaText = "Contact Us",
  ctaPath = "/contact",
  phoneText = "Call Us",
  phoneNumber = "+4612345678",
} = Astro.props;
---

<header class="site-header">
  <div class="upper-header-container">
    <p class="shell">Building for people since 1829 &nbsp;&nbsp;—&nbsp;&nbsp; because everyone deserves a home</p>
  </div>
  <div class="header-container shell">

    <!-- Brand / Logo -->
    <a href="/" class="brand-link" aria-label={`${companyName} - Home`}>
      {logoImage ? (
        <Image 
          src={logoImage} 
          alt={`${companyName} logo`} 
          class="site-logo" 
          width={160} 
          height={40} 
        />
      ) : (
        <span class="brand-text">{companyName}</span>
      )}
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul>
        {navigationLinks.map((item) => (
          <li><a href={item.path}>{item.title}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (e.g. Mini-CTA) -->
    {showCta && (
      <div class="header-actions">
        <a href={ctaPath} class="header-cta cta-desktop">{ctaText}</a>
        <a href={`tel:${phoneNumber}`} class="header-cta cta-mobile">{phoneText}</a>
      </div>
    )}

    <!-- Mobile Menu Toggle Button -->
    <button class="mobile-toggle" aria-label="Toggle Navigation" aria-expanded="false">
      <span class="hamburger-icon"></span>
    </button>

  </div>
</header>

<style>
  .site-header {
    background-color: color-mix(in srgb, var(--color-bg-alt-one) 90%, transparent 10%);
    border-bottom: 1px solid rgba(0 0 0 / 0.05);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .upper-header-container {
    background-color: var(--color-item-one-dark);
    padding: 0.6rem 0;
    text-transform: uppercase;
  }

  .upper-header-container p {
    color: rgba(255, 254, 240, 0.8);
    font-family: var(--font-second);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 1px;
    text-align: center;
    /* width: 100%; */
  }

  .header-container {
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-logo {
    height: auto;
    max-width: 70px;
    object-fit: contain;
  }

  .brand-text {
    font-weight: bold;
    font-size: 1.25rem;
    color: var(--site-text);
  }

  .desktop-nav ul {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 2.6rem;
  }

  .desktop-nav a {
    position: relative;
    font-family: var(--font-second);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .desktop-nav a:hover {
    color: var(--color-text-light);
  }

  .desktop-nav a::before {
    content: "";
    position: absolute;
    top: 25px;
    left: 0;
    right: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text-light);
    opacity: 0;
    transition: transform 300ms ease, opacity 300ms linear;
  }

  .desktop-nav a:hover::before {
    opacity: 1;
    transform: translateY(-3px);
  }

  .header-cta {
    background-color: transparent;
    color: var(--color-text);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    border: 1px solid rgb(0 0 0 / 0.2);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;

  }

  .cta-mobile {
    display: none;
  }

  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  /* Responsive layout adjustment for mobile */
  @media (max-width: 768px) {
    .desktop-nav,
    .header-actions {
      display: none;
    }

    .mobile-toggle {
      display: block;
    }
  }
</style>